{
  "scripts": {
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "build": "cd client && npm install && npm run build && cd ../server && npm install",
    "start": "node server/index.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
